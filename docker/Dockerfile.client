# =============================================================================
# EMP Performance — Client Dockerfile (multi-stage, production)
# =============================================================================

# --- Build stage ---
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/client/package.json packages/client/
RUN pnpm install --frozen-lockfile

COPY packages/shared/ packages/shared/
COPY packages/client/ packages/client/
ARG VITE_API_URL=/api/v1
ARG VITE_SSO_LOGIN_URL
ARG VITE_EMPCLOUD_RETURN_ORIGINS
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_SSO_LOGIN_URL=${VITE_SSO_LOGIN_URL}
ENV VITE_EMPCLOUD_RETURN_ORIGINS=${VITE_EMPCLOUD_RETURN_ORIGINS}
RUN pnpm --filter @emp-performance/shared build
RUN pnpm --filter @emp-performance/client build

# --- Nginx stage ---
FROM nginx:alpine
COPY --from=builder /app/packages/client/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/frontend-health >/dev/null || exit 1
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]

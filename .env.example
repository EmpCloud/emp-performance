# Runtime
NODE_ENV=development
PORT=4300
HOST=0.0.0.0
APP_URL=http://localhost:5177
CORS_ORIGIN=http://localhost:5177

# EMP Performance database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-me
DB_NAME=emp_performance
DB_POOL_MIN=2
DB_POOL_MAX=10

# Shared EMP Cloud identity database
EMPCLOUD_DB_HOST=localhost
EMPCLOUD_DB_PORT=3306
EMPCLOUD_DB_USER=root
EMPCLOUD_DB_PASSWORD=replace-me
EMPCLOUD_DB_NAME=empcloud

# EMP Cloud SSO (required in production)
# Store PEM newlines as literal \n sequences when your environment requires a
# single-line value. The token must carry sub, org_id, client_id, and jti.
EMPCLOUD_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
EMPCLOUD_SSO_ISSUER=empcloud
EMPCLOUD_SSO_AUDIENCE=emp-performance
EMPCLOUD_SSO_CLIENT_ID=empcloud-dashboard

# Legacy read-only dashboard widget integration. Leave unset when unused.
INTERNAL_SERVICE_SECRET=

# Application sessions (use a long, randomly generated value in production)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=performance@empcloud.com

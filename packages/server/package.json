{
  "name": "@emp-performance/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "test": "vitest run --config vitest.ci.config.ts",
    "test:all": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/server/src/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@emp-performance/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.30.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.0",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "swagger-ui-dist": "^5.32.8",
    "uuid": "^11.1.1",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
